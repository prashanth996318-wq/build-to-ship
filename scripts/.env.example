# Scripts Environment Variables
# Copy this file to .env and fill in your actual values.
# These variables are used ONLY by the migration runner — never by the browser.

# ==============================================================================
# SUPABASE DIRECT DATABASE CONNECTION
# ==============================================================================
# Found in: Supabase Dashboard → Project Settings → Database
# Use the "Direct connection" string (not Transaction Pooler) for DDL migrations.
# Format: postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@[HOST]:5432/postgres
#
# Direct connection (recommended for migrations):
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-db-password]@db.[your-project-ref].supabase.co:5432/postgres

# Alternative: you can also supply individual components:
# SUPABASE_DB_HOST=db.your-project-ref.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=your-db-password
